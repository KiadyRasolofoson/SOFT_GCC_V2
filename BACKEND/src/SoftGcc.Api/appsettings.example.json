{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "https://localhost:5189",
    "Audience": "https://localhost:5189"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "your-email@gmail.com",
    "Password": "YOUR_APP_PASSWORD",
    "From": "your-email@gmail.com"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "your-email@gmail.com",
    "Password": "YOUR_APP_PASSWORD",
    "SenderEmail": "your-email@gmail.com"
  },
  "License": {
    "ExcludedPaths": ["/api/auth", "/api/license", "/swagger", "/health"],
    "Enabled": true
  },
  "ReminderSettings": {
    "DaysBefore": 2
  },
  "FrontendBaseUrl": "http://localhost:5173",
  "AiAgent": {
    "EncryptionKey": "CHANGE_ME_AI_AGENT_ENCRYPTION_KEY_MIN_32_CHARS"
  },
  "Database": {
    "ApplyOnStartup": true,
    "SeedIfEmpty": true
  }
}
