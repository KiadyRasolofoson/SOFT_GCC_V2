# Variables d'environnement — Frontend Angular SOFT GCC V2
# Copier ce fichier vers .env et modifier les valeurs selon votre environnement.
# Ce fichier EST versionné (exemple de référence).
# Le fichier .env local NE DOIT PAS être commité (il est ignoré par .gitignore).

# ──────────────────────────────────────────────────────────────────────────────
# API BACKEND
# URL de base de l'API ASP.NET Core.
# Ne pas inclure de slash final.
# ──────────────────────────────────────────────────────────────────────────────
NG_API_URL=http://localhost:5189/api

# ──────────────────────────────────────────────────────────────────────────────
# PORT DE DÉVELOPPEMENT
# Port sur lequel ng serve démarre le frontend Angular.
# ──────────────────────────────────────────────────────────────────────────────
NG_PORT=4201
