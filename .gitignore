# === Dossier test ===
test/

# === BACKEND - Build artifacts ===
BACKEND/bin/
BACKEND/obj/
BACKEND/src/**/bin/
BACKEND/src/**/obj/
BACKEND/tests/**/bin/
BACKEND/tests/**/obj/

# === License / configuration files ===
LicenseGenerator/bin/
LicenseGenerator/obj/
LicenseGenerator.UI/bin/
LicenseGenerator.UI/obj/

# === License Generator UI - Build artifacts ===
LicenseGenerator.UI/bin/
LicenseGenerator.UI/obj/

# === License Generator UI - Settings persistant (local) ===
LicenseGenerator.UI/settings.json

# === Tests - Build artifacts ===
BACKEND/tests/SoftGcc.Tests/bin/
BACKEND/tests/SoftGcc.Tests/obj/
soft_carriere_competence.Tests/bin/
soft_carriere_competence.Tests/obj/

# === BACKEND - Fichiers temporaires éditeur ===
BACKEND/**/*.tmp
BACKEND/**/*.~

# === BACKEND - Historique des backups ===
BACKEND/.history/

# === BACKEND - node_modules (si npm installé par erreur) ===
BACKEND/node_modules/

# === FRONTEND REACT (old_frontend) - Build output ===
old_frontend/dist/
old_frontend/dist-ssr/

# === FRONTEND REACT (old_frontend) - Dépendances ===
old_frontend/node_modules/

# === DESIGN SYSTEM (Angular, indépendant) ===
design-system/node_modules/
design-system/dist/

# === FRONTEND ANGULAR ===
frontend/node_modules/
frontend/dist/
frontend/.angular/

# === FRONTEND REACT (old_frontend) - Historique des backups ===
old_frontend/.history/

# === IDE / Éditeurs ===
.vscode/*
!.vscode/extensions.json
# settings.json local (SQLTools credentials, etc.) — ne jamais versionner
.idea/
*.suo
*.user
*.userprefs
*.ntvs*
*.njsproj
*.sln.docstates

# === OS files ===
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Fichiers temporaires ===
*.tmp
*.swp
*.swo
*~
*.bak
*.cache

# === Environnement ===
.env
.env.local
.env.*.local

# === BACKEND - Secrets (ne jamais versionner) ===
BACKEND/appsettings.json
BACKEND/appsettings.*.json
!BACKEND/appsettings.example.json
BACKEND/src/SoftGcc.Api/appsettings.json
BACKEND/src/SoftGcc.Api/appsettings.*.json
