# ============================================
# SOFT GCC V2 — Root .gitignore
# ============================================

# === Documents personnels / archives ===
.docs_perso/

# === Dossier test ===
test/

# === BACKEND - Build artifacts ===
BACKEND/bin/
BACKEND/obj/

# === License / configuration files ===
LicenseGenerator/bin/
LicenseGenerator/obj/

# === Tests - Build artifacts ===
soft_carriere_competence.Tests/bin/
soft_carriere_competence.Tests/obj/

# === BACKEND - Fichiers temporaires éditeur ===
BACKEND/**/*.tmp
BACKEND/**/*.~

# === BACKEND - Historique des backups ===
BACKEND/.history/

# === BACKEND - node_modules (si npm installé par erreur) ===
BACKEND/node_modules/

# === FRONTEND - Build output ===
front_soft_gcc/dist/
front_soft_gcc/dist-ssr/

# === FRONTEND - Dépendances ===
front_soft_gcc/node_modules/

# === FRONTEND - Historique des backups ===
front_soft_gcc/.history/

# === Photo - Fichiers volumineux / espaces ===
# (Optionnel: décommenter si vous ne voulez pas versionner les photos)
# Photo/*.jpeg
# Photo/*.jpg
# Photo/*.png

# === IDE / Éditeurs ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userprefs
*.ntvs*
*.njsproj
*.sln.docstates

# === OS files ===
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Fichiers temporaires ===
*.tmp
*.swp
*.swo
*~
*.bak
*.cache

# === Environnement ===
.env
.env.local
.env.*.local

# === Node (root) ===
node_modules/

# === NuGet ===
packages/
*.nupkg
*.snupkg

/rapport
